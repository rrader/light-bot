# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_username_or_id
TELEGRAM_SCHEDULE_CHANNEL_ID=@your_schedule_channel_or_id
# TELEGRAM_API_BASE_URL - Leave unset for production (uses https://api.telegram.org)
#                       - Set for E2E testing only (e.g., http://telegram-mock:8080)

# Monitor Configuration (only for client, not needed in server .env)
UDR_API_KEY=key
TARGET_IP=192.168.1.152

# Server Configuration
FLASK_PORT=5000
API_TOKEN=your_secure_api_token_here
WATCHDOG_STATUS_FILE=watchdog_status.txt
DB_PATH=light_bot.db
TIMEZONE=Europe/Kyiv

# Data Directory Configuration
# Directory for schedule state files (default: current directory)
# Useful for organizing data files in a separate directory
# Example: DATA_DIR=./data
DATA_DIR=.

# Yasno Power Schedule Configuration
# YASNO_API_BASE_URL - Leave unset for production (uses https://app.yasno.ua)
#                    - Set for E2E testing only (e.g., http://yasno-mock:8081)

# Power groups to monitor (JSON format with id, group/group_dynamic, city, optional channel)
# Format: [{"id": "home", "group": "2.1", "city": "kiev"}, ...]
#
# Fields:
#   id: Unique identifier for this config (used in filenames, e.g., "home", "office", "kyiv_2_1")
#   group: Static Yasno power group (e.g., "2.1", "3.1") - use this OR group_dynamic
#   group_dynamic: URL to fetch group dynamically - use this OR group (see example below)
#   city: City name - supported: "kiev" (Київ), "dnipro" (Дніпро)
#   channel: (optional) Telegram channel ID - if not specified, uses TELEGRAM_SCHEDULE_CHANNEL_ID
#
# The group_dynamic URL should return JSON in format: {"group":5,"subgroup":1}
# This will be converted to group "5.1"
#
# Examples:
#   Single static group:
#     YASNO_GROUPS=[{"id": "home", "group": "2.1", "city": "kiev"}]
#
#   Single dynamic group:
#     YASNO_GROUPS=[{"id": "home", "group_dynamic": "https://app.yasno.ua/api/blackout-service/public/shutdowns/addresses/v2/group?regionId=25&streetId=189&houseId=5679&dsoId=902", "city": "kiev"}]
#
#   Multiple groups (mixed static and dynamic):
#     YASNO_GROUPS=[{"id": "home", "group": "2.1", "city": "kiev"}, {"id": "office", "group_dynamic": "https://app.yasno.ua/api/...", "city": "kiev"}]
#
#   Multiple cities (Kyiv and Dnipro):
#     YASNO_GROUPS=[{"id": "kyiv_home", "group": "2.1", "city": "kiev"}, {"id": "dnipro_office", "group": "1.1", "city": "dnipro"}]
#
#   Different channels per group:
#     YASNO_GROUPS=[{"id": "home", "group": "2.1", "city": "kiev", "channel": "@home_channel"}, {"id": "office", "group": "3.1", "city": "kiev", "channel": "@office_channel"}]
YASNO_GROUPS=[{"id": "home", "group": "2.1", "city": "kiev"}]

# Schedule Check Configuration
SCHEDULE_CHECK_INTERVAL=3600

# Schedule Monitoring Time Windows
# Today's schedule monitoring window (when to check for changes to today's schedule)
SCHEDULE_TODAY_START_HOUR=0    # Start checking at midnight
SCHEDULE_TODAY_END_HOUR=21     # Stop checking at 9 PM

# Tomorrow's schedule monitoring window (when to check for tomorrow's schedule)
SCHEDULE_TOMORROW_START_HOUR=18  # Start checking at 6 PM
SCHEDULE_TOMORROW_END_HOUR=23    # Stop checking at 11 PM

# Outage Warning Configuration
OUTAGE_WARNING_MINUTES=30  # Send warning N minutes before outage
OUTAGE_WARNING_CHECK_INTERVAL=300  # Check every 5 minutes for upcoming outages

# Group Resolution Configuration
# How often to re-resolve dynamic groups (in seconds)
# Default: 21600 (6 hours)
# Set to 0 to disable periodic resolution (only resolve at startup)
# This is only relevant for groups configured with group_dynamic
GROUP_RESOLUTION_INTERVAL=21600

# Note: State files are now automatically created with group suffix
# Example: Group "2.1" creates files like last_schedule_today_hash_2_1.txt

# OpenAI API Configuration (optional - for AI explanations of schedule changes)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ENABLE_AI_EXPLANATIONS=true
