# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_username_or_id
TELEGRAM_SCHEDULE_CHANNEL_ID=@your_schedule_channel_or_id
# TELEGRAM_API_BASE_URL - Leave unset for production (uses https://api.telegram.org)
#                       - Set for E2E testing only (e.g., http://telegram-mock:8080)

# Monitor Configuration (only for client, not needed in server .env)
UDR_API_KEY=key
TARGET_IP=192.168.1.152

# Server Configuration
FLASK_PORT=5000
API_TOKEN=your_secure_api_token_here
WATCHDOG_STATUS_FILE=watchdog_status.txt
TIMEZONE=Europe/Kyiv

# Yasno Power Schedule Configuration (Kiev region only)
YASNO_GROUP=2.1
YASNO_CITY=kiev
# YASNO_API_BASE_URL - Leave unset for production (uses https://app.yasno.ua)
#                    - Set for E2E testing only (e.g., http://yasno-mock:8081)

# Schedule Check Configuration
SCHEDULE_CHECK_INTERVAL=3600

# Schedule Monitoring Time Windows
# Today's schedule monitoring window (when to check for changes to today's schedule)
SCHEDULE_TODAY_START_HOUR=0    # Start checking at midnight
SCHEDULE_TODAY_END_HOUR=21     # Stop checking at 9 PM

# Tomorrow's schedule monitoring window (when to check for tomorrow's schedule)
SCHEDULE_TOMORROW_START_HOUR=18  # Start checking at 6 PM
SCHEDULE_TOMORROW_END_HOUR=23    # Stop checking at 11 PM

# Status Files (dual-hash system for independent today/tomorrow tracking)
LAST_SCHEDULE_TODAY_HASH_FILE=last_schedule_today_hash.txt
LAST_SCHEDULE_TOMORROW_HASH_FILE=last_schedule_tomorrow_hash.txt
LAST_SCHEDULE_TODAY_DATA_FILE=last_schedule_today_data.json
LAST_SCHEDULE_TOMORROW_DATA_FILE=last_schedule_tomorrow_data.json
LAST_CHECK_DATE_FILE=last_check_date.txt
TOMORROW_SENT_DATE_FILE=tomorrow_sent_date.txt

# Outage Warning Configuration
OUTAGE_WARNING_MINUTES=30  # Send warning N minutes before outage
OUTAGE_WARNING_CHECK_INTERVAL=300  # Check every 5 minutes for upcoming outages
LAST_WARNING_SENT_FILE=last_warning_sent.txt

# OpenAI API Configuration (optional - for AI explanations of schedule changes)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-nano
# ENABLE_AI_EXPLANATIONS=true
