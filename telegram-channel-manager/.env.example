# Telegram API Credentials
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Phone number associated with your Telegram account
TELEGRAM_PHONE=+1234567890

# State file location (optional, defaults to channels.json in the same directory)
STATE_FILE=channels.json

# Session file name (optional, defaults to telegram_session)
SESSION_NAME=telegram_session
